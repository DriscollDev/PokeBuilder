<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <link rel="stylesheet" href="/stylesheets/pokestyle.css" />
    <link
      rel="icon"
      type="image/x-icon"
      href="https://upload.wikimedia.org/wikipedia/commons/5/53/Pok%C3%A9_Ball_icon.svg"
    />
  </head>
  <body class="bg-gray-600 text-white min-h-screen flex items-center justify-center">
    <main
      class="bg-gray-600 border-8 border-red-600 shadow-xl w-full h-screen flex flex-col justify-center items-center p-6"
    >
      <div
        class="max-w-5xl w-full bg-gray-300 text-black rounded-md border-2 border-black shadow-lg p-6 space-y-4"
      >
        <header class="space-y-1">
          <h1 class="text-2xl font-bold text-center">Admin Panel</h1>
          <p class="text-center text-sm text-gray-700">
            Manage users and authorization levels
          </p>
          <% if (typeof currentUserLevel !== 'undefined') { %>
            <p class="text-center text-xs text-gray-600">
              You are level <strong><%= currentUserLevel %></strong>. You can manage only users with lower
              authorization levels.
            </p>
          <% } %>
        </header>

        <div id="alertContainer" class="space-y-2"></div>

        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200 bg-white rounded-md overflow-hidden">
            <thead class="bg-gray-100">
              <tr>
                <th
                  scope="col"
                  class="px-4 py-2 text-left text-sm font-semibold text-gray-700"
                >
                  User ID
                </th>
                <th
                  scope="col"
                  class="px-4 py-2 text-left text-sm font-semibold text-gray-700"
                >
                  Username
                </th>
                <th
                  scope="col"
                  class="px-4 py-2 text-left text-sm font-semibold text-gray-700"
                >
                  Auth Level
                </th>
                <th
                  scope="col"
                  class="px-4 py-2 text-left text-sm font-semibold text-gray-700"
                >
                  Date Created
                </th>
                <th
                  scope="col"
                  class="px-4 py-2 text-right text-sm font-semibold text-gray-700"
                >
                  Actions
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% users.forEach(user => { 
                const userLevel = Number(user.authorizationLevel);
                const isSelf = (typeof currentUserID !== 'undefined' && user.userID === currentUserID);
                const canEdit = !isSelf && (
                    (currentUserLevel === 3) ||
                    (currentUserLevel === 2 && (userLevel === 0 || userLevel === 1))
                );
                const canDelete = !isSelf && (
                    (currentUserLevel === 3) ||
                    (currentUserLevel === 2 && (userLevel === 0 || userLevel === 1)) ||
                    (currentUserLevel === 1 && userLevel === 0)
                );
              %>
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-2 text-sm text-gray-800"><%= user.userID %></td>
                  <td class="px-4 py-2 text-sm text-gray-800"><%= user.username %></td>
                  <td class="px-4 py-2 text-sm">
                    <% if (userLevel === 0) { %>
                      <span class="inline-block px-2 py-1 rounded text-xs font-semibold bg-gray-200 text-gray-700">
                        Level 0 - User
                      </span>
                    <% } else if (userLevel === 1) { %>
                      <span class="inline-block px-2 py-1 rounded text-xs font-semibold bg-blue-100 text-blue-700">
                        Level 1 - Moderator
                      </span>
                    <% } else if (userLevel === 2) { %>
                      <span class="inline-block px-2 py-1 rounded text-xs font-semibold bg-green-100 text-green-700">
                        Level 2 - Admin
                      </span>
                    <% } else if (userLevel === 3) { %>
                      <span class="inline-block px-2 py-1 rounded text-xs font-semibold bg-orange-100 text-orange-700">
                        Level 3 - Owner
                      </span>
                    <% } %>
                  </td>
                  <td class="px-4 py-2 text-sm text-gray-800">
                    <%= new Date(user.date_created).toLocaleDateString() %>
                  </td>
                  <td class="px-4 py-2">
                    <div class="flex justify-end gap-2">
                      <% if (canEdit) { %>
                        <button
                          class="px-3 py-1 text-xs font-semibold rounded bg-blue-500 hover:bg-blue-600 text-white transition"
                          onclick="openEditModal(`<%= user.userID %>`, '<%= user.username %>', `<%= user.authorizationLevel %>`)"
                        >
                          Edit
                        </button>
                      <% } %>
                      <% if (canDelete) { %>
                        <button
                          class="px-3 py-1 text-xs font-semibold rounded bg-red-500 hover:bg-red-600 text-white transition"
                          onclick="openDeleteModal(`<%= user.userID %>`, '<%= user.username %>`)"
                          id="delete-btn-<%= user.userID %>"
                        >
                          Delete
                        </button>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <!-- Edit Modal -->
    <div
      id="editModal"
      class="fixed inset-0 bg-black/40 hidden items-center justify-center z-50"
    >
      <div class="bg-white rounded-lg shadow-xl p-6 max-w-md w-full">
        <div class="mb-4">
          <h2 class="text-xl font-semibold text-gray-900">Edit User Authorization</h2>
        </div>
        <div class="space-y-4">
          <p id="editUsername" class="text-sm text-gray-700"></p>
          <div>
            <label
              for="authLevel"
              class="block text-sm font-medium text-gray-700 mb-1"
              >Authorization Level</label
            >
            <select
              id="authLevel"
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm text-sm bg-white text-gray-900"
            >
              <option value="0">Level 0 - User</option>
              <option value="1">Level 1 - Moderator</option>
              <option value="2">Level 2 - Admin</option>
              <option value="3">Level 3 - Owner</option>
            </select>
          </div>
        </div>
        <div class="mt-6 flex justify-end gap-3">
          <button
            class="px-4 py-2 rounded bg-gray-300 text-gray-800 text-sm font-medium hover:bg-gray-400 transition"
            onclick="closeEditModal()"
          >
            Cancel
          </button>
          <button
            class="px-4 py-2 rounded bg-green-500 text-white text-sm font-medium hover:bg-green-600 transition"
            onclick="saveAuthLevel()"
          >
            Save
          </button>
        </div>
      </div>
    </div>

    <!-- Delete Modal -->
    <div
      id="deleteModal"
      class="fixed inset-0 bg-black/40 hidden items-center justify-center z-50"
    >
      <div class="bg-white rounded-lg shadow-xl p-6 max-w-md w-full">
        <div class="mb-4">
          <h2 class="text-xl font-semibold text-gray-900">Delete User</h2>
        </div>
        <div class="space-y-3">
          <p class="text-sm text-gray-700">
            Are you sure you want to delete user
            <strong id="deleteUsername"></strong>?
          </p>
          <p class="text-sm font-semibold text-red-600">
            This action cannot be undone and will delete all associated data.
          </p>
        </div>
        <div class="mt-6 flex justify-end gap-3">
          <button
            class="px-4 py-2 rounded bg-gray-300 text-gray-800 text-sm font-medium hover:bg-gray-400 transition"
            onclick="closeDeleteModal()"
          >
            Cancel
          </button>
          <button
            class="px-4 py-2 rounded bg-red-500 text-white text-sm font-medium hover:bg-red-600 transition"
            onclick="confirmDelete()"
          >
            Delete
          </button>
        </div>
      </div>
    </div>

    <script>
        const currentUserLevel = <%= typeof currentUserLevel !== 'undefined' ? currentUserLevel : 0 %>;
        let currentUserID = null;
        let currentUsername = null;

        function resetAuthLevelOptions(selectElement) {
            while (selectElement.firstChild) {
                selectElement.removeChild(selectElement.firstChild);
            }
        }

        function addAuthLevelOption(selectElement, value, label) {
            const option = document.createElement('option');
            option.value = String(value);
            option.textContent = label;
            selectElement.appendChild(option);
        }

        function showAlert(message, type = 'success') {
            const alertContainer = document.getElementById('alertContainer');
            const alert = document.createElement('div');
            alert.className =
                'px-4 py-2 rounded text-sm border ' +
                (type === 'success'
                    ? 'bg-green-100 text-green-800 border-green-300'
                    : 'bg-red-100 text-red-800 border-red-300');
            alert.textContent = message;
            alertContainer.appendChild(alert);

            setTimeout(() => {
                alert.remove();
            }, 5000);
        }

        function openEditModal(userID, username, authLevel) {
            currentUserID = userID;
            currentUsername = username;
            document.getElementById('editUsername').textContent = `User: ${username}`;
            const select = document.getElementById('authLevel');
            resetAuthLevelOptions(select);

            const userLevel = Number.parseInt(authLevel, 10);

            if (currentUserLevel === 3) {
                // Owner: can set any level 0–3
                addAuthLevelOption(select, 0, 'Level 0 - User');
                addAuthLevelOption(select, 1, 'Level 1 - Moderator');
                addAuthLevelOption(select, 2, 'Level 2 - Admin');
                addAuthLevelOption(select, 3, 'Level 3 - Owner');
                select.value = String(userLevel);
            } else if (currentUserLevel === 2 && (userLevel === 0 || userLevel === 1)) {
                // Level 2: can move users between 0 and 1
                addAuthLevelOption(select, 0, 'Level 0 - User');
                addAuthLevelOption(select, 1, 'Level 1 - Moderator');
                select.value = String(userLevel);
            } else {
                // Fallback: should not normally be reachable because Edit is hidden,
                // but keep a safe default.
                addAuthLevelOption(select, userLevel, `Level ${userLevel}`);
                select.value = String(userLevel);
            }

            const modal = document.getElementById('editModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeEditModal() {
            const modal = document.getElementById('editModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            currentUserID = null;
            currentUsername = null;
        }

        function openDeleteModal(userID, username) {
            currentUserID = userID;
            currentUsername = username;
            document.getElementById('deleteUsername').textContent = username;
            const modal = document.getElementById('deleteModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeDeleteModal() {
            const modal = document.getElementById('deleteModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            currentUserID = null;
            currentUsername = null;
        }

        async function saveAuthLevel() {
            const authLevel = document.getElementById('authLevel').value;

            try {
                const response = await fetch('/admin/update-auth-level', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        userID: currentUserID,
                        authorizationLevel: authLevel
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showAlert('Authorization level updated successfully', 'success');
                    closeEditModal();
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showAlert(data.error, 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showAlert('Error updating authorization level', 'error');
            }
        }

        async function confirmDelete() {
            try {
                const response = await fetch('/admin/delete-user', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        userID: currentUserID
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showAlert('User deleted successfully', 'success');
                    closeDeleteModal();
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showAlert(data.error, 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showAlert('Error deleting user', 'error');
            }
        }

        // Close modal when clicking outside
        document.getElementById('editModal').addEventListener('click', function(e) {
            if (e.target === this) closeEditModal();
        });

        document.getElementById('deleteModal').addEventListener('click', function(e) {
            if (e.target === this) closeDeleteModal();
        });
    </script>
  </body>
  </html>
