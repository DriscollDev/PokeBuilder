<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <link rel="stylesheet" href="/stylesheets/pokestyle.css" />
    <link
      rel="icon"
      type="image/x-icon"
      href="https://upload.wikimedia.org/wikipedia/commons/5/53/Pok%C3%A9_Ball_icon.svg"
    />
  </head>
  <body class="bg-gray-600 text-white min-h-screen flex items-center justify-center">
    <main
      class="bg-gray-600 border-8 border-red-600 shadow-xl w-full h-screen flex flex-col justify-center items-center p-6"
    >
      <div
        class="max-w-xl w-full bg-gray-300 text-black rounded-md border-2 border-black shadow-lg p-6 space-y-4 text-center"
      >
        <h1 class="text-3xl font-bold">
          <%= title %>
        </h1>
        <p class="text-sm text-gray-700">
          <%= message %>
        </p>
        <div class="text-xs text-gray-600">
          Error 403 – You do not have permission to access this page.
        </div>
        <div class="pt-2">
          <a
            href="/"
            class="inline-flex items-center px-4 py-2 rounded-lg bg-red-600 text-white text-sm font-semibold border-2 border-black hover:bg-red-500 transition"
          >
            Return Home
          </a>
        </div>
      </div>
    </main>
  </body>
</html>
